SCANSOCIAL_HOST=127.0.0.1
SCANSOCIAL_PORT=8765
# Set environment variables explicitly; this file is a configuration example.
# Do not commit real tokens. Prefer OS keyring via the Settings UI.
# SCANSOCIAL_SESSION_TOKEN=your-development-token
# SCANSOCIAL_DATA_DIR=/absolute/path/to/CRM-data
SCANSOCIAL_RAW_SCAN_RETENTION_HOURS=24
SCANSOCIAL_DEFAULT_AI_PROVIDER=heuristic
SCANSOCIAL_FACEBOOK_PAGE_IDS=[]
SCANSOCIAL_FACEBOOK_GRAPH_VERSION=v22.0
